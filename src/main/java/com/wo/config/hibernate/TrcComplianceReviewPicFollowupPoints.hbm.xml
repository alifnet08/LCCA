<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcComplianceReview.model">
	<class name="TrcComplianceReviewPicFollowupPoints" table="wo_trc_cmplc_rvw_pc_fp_points">
		<id name="complianceReviewPicFollowupPointsId" column="cmplc_rvw_pic_fp_points_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_cmplc_rvw_pc_fp_pts_sq</param>
			</generator>
		</id>

		<many-to-one name="trcComplianceReviewPicFollowup" column="CMPLC_REVIEW_PIC_FOLLOWUP_ID"
			class="com.wo.module.trcComplianceReview.model.TrcComplianceReviewPicFollowup"
			fetch="join" />

		<property name="followupPoints" column="followup_points" type="string" />
		<many-to-one name="followupBy" column="followup_by_id"
			class="com.wo.module.user.model.User" fetch="join" />
		<property name="confirmationDate" column="confirmation_date" type="date" />
		<property name="followupDate" column="followup_date" type="date" />
		<property name="followupNote" column="followup_note" type="string" />
		
		<bag name="trcComplianceReviewPicFollowupPointsAttachments" inverse="true"
			cascade="save-update, delete-orphan" order-by="cmplc_rvw_pc_fp_pts_ach_id asc">
			<key column="cmplc_rvw_pic_fp_points_id" />
			<one-to-many
				class="com.wo.module.trcComplianceReview.model.TrcComplianceReviewPicFollowupPointsAttachment" />
		</bag>
			
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
