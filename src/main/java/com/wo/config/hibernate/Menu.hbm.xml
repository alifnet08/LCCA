<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.menu.model">
	<class name="Menu" table="wo_mst_menu">
		<id name="menuId" column="MENU_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_menu_seq</param>
			</generator>
		</id>

		<property name="nameIn" column="NAME_IN" type="string" />
		<property name="nameEn" column="NAME_EN" type="string" />
		<property name="action" column="ACTION" type="string" />
		<property name="description" column="DESCRIPTION" type="string" />
		<property name="fontawesome" column="FONTAWESOME" type="string" />
		<property name="menuOrder" column="MENU_ORDER" type="long" />
		<property name="menuLevel" column="MENU_LEVEL" type="long" />


		<property name="parentId" column="PARENT_ID" type="long" />

		<!-- <many-to-one name="parentId" column="PARENT_ID" class="com.wo.module.menu.model.Menu" 
			fetch="select" not-found="ignore" /> -->


		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

		<bag name="detail" inverse="true" cascade="save-update, delete-orphan"
			order-by="MENU_LEVEL asc, menu_order asc">
			<key column="parent_id" />
			<one-to-many not-found="ignore" class="com.wo.module.menu.model.Menu" />
			<filter name="myFilter" condition="1=1"></filter>
		</bag>


	</class>
	<filter-def name="myFilter">

	</filter-def>
</hibernate-mapping>
