<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.counterType.model">
	<class name="CounterTypeDtl" table="wo_mst_counter_type_dtl">
		<id name="counterTypeDtlId" column="COUNTER_TYPE_DTL_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_counter_type_dtl_seq</param>
			</generator>
		</id>

		<many-to-one name="counterType" column="COUNTER_TYPE_ID"
			class="com.wo.module.counterType.model.CounterType" fetch="join">
		</many-to-one>

		<property name="slaType" column="SLA_TYPE" type="string" />
		<property name="sla" column="SLA" type="long" />

		<property name="emailTo" column="EMAIL_TO" type="string" />
		<property name="emailCc2" column="EMAIL_CC_2" type="string" />
		<property name="emailCc1" column="EMAIL_CC_1" type="string" />


		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />


	</class>
</hibernate-mapping>
