<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.litigation.model">
	<class name="LitigationPidanaTerlapor" table="wo_mst_liti_pidana_terlapor">
		<id name="litigationId" column="LITIGATION_ID" type="long">
			<generator class="foreign">
				<param name="property">litigation</param>
			</generator>
		</id>
		
		<one-to-one name="litigation" cascade="all" />
			
		<property name="caseYear" column="CASE_YEAR" type="integer" />
		<property name="caseNumber" column="CASE_NUMBER" type="string" />
		<property name="tindakPidana" column="TINDAK_PIDANA" type="string" />
		<property name="examiningAgency" column="EXAMINING_AGENCY" type="string" />
		
		<many-to-one name="caseHandler" property-ref="parameterDtlCode"
			column="CASE_HANDLER" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
		<property name="attorneyOfficeName" column="ATTORNEY_OFFICE_NAME" type="string" />
		
		<property name="casePosition" column="CASE_POSITION" type="string" />
		<property name="caseValueIdr" column="CASE_VALUE_IDR" type="double" />
		
		<many-to-one name="foreignCurrencyType" property-ref="parameterDtlCode"
			column="FOREIGN_CURRENCY" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
		<property name="caseValueValas" column="CASE_VALUE_VALAS" type="string" />
		
		<property name="inspectionLevelPol" column="INSPECT_LEVEL_POL" type="string" />
		<property name="inspectionLevelPn" column="INSPECT_LEVEL_PN" type="string" />
		<property name="inspectionLevelJaksa" column="INSPECT_LEVEL_JAKSA" type="string" />
		<property name="inspectionLevelFinished" column="INSPECT_LEVEL_FINISHED" type="string" />	
		<property name="attorney" column="ATTORNEY" type="string" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE" type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	</class>
</hibernate-mapping>
