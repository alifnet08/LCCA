<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcRmd.model">
	<class name="TrcRmdRegulation" table="wo_trc_rmd_regulation">
		<id name="rmdRegulationId" column="RMD_REGULATION_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_rmd_regulation_seq</param>
			</generator>
		</id>

		<many-to-one name="trcRmd" column="RMD_ID"
			class="com.wo.module.trcRmd.model.TrcRmd" fetch="join" />

		<!-- <property name="regulationId" column="REGULATION_ID" type="long" /> -->
		<many-to-one name="regulationMst" column="regulation_id"
			class="com.wo.module.externalRegulation.model.RegulationMst" fetch="join" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
