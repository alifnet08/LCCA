<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.tmpAudit.model">
	<class name="TmpAuditPicFollowupBankResponse" table="wo_tmp_adt_pc_fp_bank_respons">
		<id name="auditPicFollowupBankResponseId" column="audit_pic_fp_bank_response_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TMP_ADT_PC_FP_BANK_RESP_SQ</param>
			</generator>
		</id>

		<many-to-one name="tmpAuditPicFollowup" column="audit_pic_followup_id"
			class="com.wo.module.tmpAudit.model.TmpAuditPicFollowup"
			fetch="join" />

		<property name="bankResponse" column="bank_response" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
