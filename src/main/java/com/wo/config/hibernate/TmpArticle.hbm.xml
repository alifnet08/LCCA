<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.article.model">
	<class name="TmpArticle" table="wo_tmp_article">
		<id name="articleId" column="ARTICLE_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_tmp_article_seq</param>
			</generator>
		</id>

		<many-to-one name="articleType"
			property-ref="parameterDtlCode" column="ARTICLE_TYPE"
			class="com.wo.module.parameter.model.ParameterDetail" fetch="join" />

		<property name="author" column="AUTHOR" type="string" />
		<property name="publishDate" column="PUBLISH_DATE"
			type="date" />
		<property name="articleTitleIn" column="ARTICLE_TITLE_IN"
			type="string" />
		<property name="articleTitleEn" column="ARTICLE_TITLE_EN"
			type="string" />
		<property name="descriptionEn" column="DESCRIPTION_EN"
			type="string" />
		<property name="descriptionIn" column="DESCRIPTION_IN"
			type="string" />
		<property name="contentIn" column="CONTENT_IN" type="string" />
		<property name="contentEn" column="CONTENT_EN" type="string" />

		<many-to-one name="status" property-ref="parameterDtlCode"
			column="STATUS" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
		
		<many-to-one name="activeStatus" property-ref="parameterDtlCode"
			column="ACTIVE_STATUS" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />

		<property name="enabledFlag" column="ENABLED_FLAG"
			type="string" />
		<property name="creationDate" column="CREATION_DATE"
			type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY"
			type="string" />
		<property name="delId" column="DEL_ID" type="long" />

		<bag name="tmpArticleTagList" inverse="true"
			cascade="save-update, delete-orphan" order-by="article_tag_id asc">
			<key column="article_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.article.model.TmpArticleTag" />
		</bag>

		<bag name="tmpArticleDocumentList" inverse="true"
			cascade="save-update, delete-orphan"
			order-by="article_document_id asc">
			<key column="article_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.article.model.TmpArticleDocument" />
		</bag>

		<bag name="tmpArticleApprovalList" inverse="true"
			cascade="save-update, delete-orphan"
			order-by="article_approval_id asc">
			<key column="article_approval_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.articleApproval.model.TmpArticleApproval" />
		</bag>

	</class>
</hibernate-mapping>
