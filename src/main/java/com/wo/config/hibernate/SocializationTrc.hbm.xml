<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.regulationSocialization.model">
	<class name="SocializationTrc" table="wo_trc_socialization">
		<id name="socializationId" column="socialization_id" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_socialization_seq</param>
			</generator>
		</id>

		<many-to-one name="jenisKetentuan" property-ref="parameterDtlCode"
			column="jenis_ketentuan" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />

		<many-to-one name="counterType" column="counter_type_id"
			class="com.wo.module.counterType.model.CounterType" fetch="join" />

		<property name="followUp" column="follow_up" type="string" />

		<property name="notes" column="notes" type="string" />

		<property name="reminderStatus" column="reminder_status"
			type="string" />

		<property name="status" column="status" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

		<bag name="socializationRegulationTrcs" inverse="true"
			cascade="save-update, delete-orphan" order-by="socialization_regulation_id asc">
			<key column="socialization_id" />
			<one-to-many
				class="com.wo.module.regulationSocialization.model.SocializationRegulationTrc" />
		</bag>

		<bag name="socializationPICComplianceTrcs" inverse="true"
			cascade="save-update, delete-orphan" order-by="socialization_pic_cmplc_id asc">
			<key column="socialization_id" />
			<one-to-many
				class="com.wo.module.regulationSocialization.model.SocializationPICComplianceTrc" />
		</bag>

		<bag name="socializationPICFollowupTrcs" inverse="true"
			cascade="save-update, delete-orphan" order-by="socialization_pic_followup_id asc">
			<key column="socialization_id" />
			<one-to-many
				class="com.wo.module.regulationSocialization.model.SocializationPICFollowupTrc" />
		</bag>
		
		<bag name="socializationDocumentTrcs" inverse="true"
			cascade="save-update, delete-orphan" order-by="socialization_document_id asc">
			<key column="socialization_id" />
			<one-to-many
				class="com.wo.module.regulationSocialization.model.SocializationDocumentTrc" />
		</bag>
	</class>
</hibernate-mapping>
