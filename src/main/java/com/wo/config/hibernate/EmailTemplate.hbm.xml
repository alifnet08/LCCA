<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.emailTemplate.model">
	<class name="EmailTemplate" table="wo_mst_email_template">
		<id name="emailTemplateId" column="EMAIL_TEMPLATE_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_email_template_seq</param>
			</generator>
		</id>

		<!-- <property name="emailTemplateCode" column="EMAIL_TEMPLATE_CODE" type="string" 
			/> -->

		<many-to-one name="emailTemplate" property-ref="parameterDtlCode"
			column="EMAIL_TEMPLATE_CODE" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

		<property name="emailSubject" column="EMAIL_SUBJECT" type="string"
			lazy="true" />
		<property name="emailContent" column="EMAIL_CONTENT" type="string"
			lazy="true" />
	</class>
</hibernate-mapping>
