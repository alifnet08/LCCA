<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.log.model">
	<class name="LogHeader" table="wo_trc_log_h">
		<id name="processId" type="long">
			<column name="PROCESS_ID" />
			<generator class="sequence">
				<param name="sequence_name">wo_trc_log_h_seq</param>
			</generator>
		</id>

		<bag name="logDetailList" inverse="true"
			cascade="save-update, merge" order-by="PROCESS_ID desc, SEQ_NO asc">
			<key column="PROCESS_ID"></key>
			<one-to-many class="com.wo.module.log.model.LogDetail" />
		</bag>

		<property name="processDate" column="PROCESS_DT" type="timestamp" />
		
		<property name="functionId" column="FUNCTION_ID" type="string" />
		<many-to-one name="functionParam" column="FUNCTION_ID"
			class="com.wo.module.parameter.model.ParameterDetail"
			property-ref="parameterDtlCode" fetch="join" insert="false" update="false" />
			
		<property name="processSts" column="PROCESS_STS" type="string" />
		<many-to-one name="processStsParam" column="PROCESS_STS"
			class="com.wo.module.parameter.model.ParameterDetail"
			property-ref="parameterDtlCode" fetch="join" insert="false" update="false" />
			
		<property name="userId" column="USER_ID" type="string" />
		<property name="endDate" column="END_DT" type="timestamp" />
		<property name="remarks" column="REMARKS" type="string" />
	</class>
</hibernate-mapping>
