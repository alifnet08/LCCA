<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.dbCompliance.model">
	<class name="DBComplianceDueDate" table="WO_MST_DB_COMPLIANCE_DUE_DATE">
		<id name="dbComplianceDueDateId" column="DB_COMPLIANCE_DUE_DATE_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_MST_DB_COMP_DUE_DATE_SEQ</param>
			</generator>
		</id>

		<many-to-one name="dbCompliance" 
			column="DATABASE_COMPLIANCE_ID" class="com.wo.module.dbCompliance.model.DBCompliance"
			fetch="join" />
			
		<property name="dueDay" column="DUE_DAY" type="long" />
		<property name="dueDateOnly" column="DUE_DATE_DATE_ONLY" type="long" />
		<property name="dueDate" column="DUE_DATE" type="date" />
		<property name="targetDate" column="TARGET_DATE" type="date" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	</class>
</hibernate-mapping>
