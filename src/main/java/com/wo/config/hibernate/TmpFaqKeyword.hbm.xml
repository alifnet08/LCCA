<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.faq.model">
	<class name="TmpFaqKeyword" table="wo_tmp_faq_keyword">
		<id name="faqKeywordId" column="FAQ_KEYWORD_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_tmp_faq_keyword_seq</param>
			</generator>
		</id>

		<many-to-one name="tmpFaq" column="FAQ_ID"
			class="com.wo.module.faq.model.TmpFaq" fetch="join" />

		<property name="keyword" column="KEYWORD" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG"
			type="string" />
		<property name="creationDate" column="CREATION_DATE"
			type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY"
			type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	</class>
</hibernate-mapping>
