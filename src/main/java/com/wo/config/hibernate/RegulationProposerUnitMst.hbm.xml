<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.externalRegulation.model">
	<class name="RegulationProposerUnitMst" table="WO_MST_REGULATION_PROPOSERUNIT">
		<id name="regulationProposerUnitId" column="REGULATION_PROPOSER_UNIT_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_regulation_pu_seq</param>
			</generator>
		</id> 

		<many-to-one name="regulation" column="regulation_id"
			class="com.wo.module.externalRegulation.model.Regulation" fetch="join" />
		
		<property name="publisherUnit" column="PUBLISHER_UNIT" type="string" />
		<property name="directorate" column="DIRECTORATE" type="string" />		
						
		<many-to-one name="pic" column="PIC_ID"
			class="com.wo.module.user.model.User" fetch="join" />
		
		<many-to-one name="puk" column="PUK_ID"
			class="com.wo.module.user.model.User" fetch="join" />
				
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE" type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	
	</class>
</hibernate-mapping>
