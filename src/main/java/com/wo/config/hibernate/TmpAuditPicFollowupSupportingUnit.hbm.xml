<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.tmpAudit.model">
	<class name="TmpAuditPicFollowupSupportingUnit" table="wo_tmp_audit_pic_fp_supp_unit">
		<id name="auditPicFollowupSupportingUnitId" column="audit_pic_fp_supp_unit_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TMP_ADT_PIC_FP_SUPP_UNIT_SQ</param>
			</generator>
		</id>

		<many-to-one name="tmpAuditPicFollowup" column="audit_pic_followup_id"
			class="com.wo.module.tmpAudit.model.TmpAuditPicFollowup"
			fetch="join" />

		<property name="divisionId" column="DIVISION_ID" type="long" />

		<many-to-one name="emailCc1" column="EMAIL_CC_ID_1"
			class="com.wo.module.user.model.User" fetch="join" />

		<many-to-one name="emailCc2" column="EMAIL_CC_ID_2"
			class="com.wo.module.user.model.User" fetch="join" />

		<many-to-one name="emailCc3" column="EMAIL_CC_ID_3"
			class="com.wo.module.user.model.User" fetch="join" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
