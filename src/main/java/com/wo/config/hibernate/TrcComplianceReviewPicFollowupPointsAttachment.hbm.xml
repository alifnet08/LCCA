<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcComplianceReview.model">
	<class name="TrcComplianceReviewPicFollowupPointsAttachment" table="wo_trc_cmplc_rvw_pc_fp_pts_ach">
		<id name="complianceReviewPicFollowupPointsAttachmentId" column="cmplc_rvw_pc_fp_pts_ach_id" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_cmp_rvw_pc_fp_pt_ach_sq</param>
			</generator>
		</id>

		<many-to-one name="trcComplianceReviewPicFollowupPoints" column="CMPLC_RVW_PIC_FP_POINTS_ID"
			class="com.wo.module.trcComplianceReview.model.TrcComplianceReviewPicFollowupPoints"
			fetch="join" />

		<property name="attachmentFile" column="ATTACHMENT_FILE"
			type="string" />
		
		<property name="fileId" column="FILE_ID" type="string" />
		<property name="fileSize" column="file_size" type="long" />
		
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
