<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcAudit.model">
	<class name="TrcAuditPicFollowupAuditFindings" table="wo_trc_audit_pic_fp_aud_fdgs">
		<id name="auditPicFollowupAuditFindingsId" column="aud_pic_fp_aud_fdgs_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_audit_pic_fp_aud_fdgs_seq</param>
			</generator>
		</id>

		<many-to-one name="trcAuditPicFollowup" column="audit_pic_followup_id"
			class="com.wo.module.trcAudit.model.TrcAuditPicFollowup"
			fetch="join" />

		<property name="auditFindings" column="audit_findings" type="string" />
		<property name="column" column="[column]" type="int" />
		<property name="hasHeader" column="has_header" type="string" />
		
		<bag name="trcAuditPicFollowupAuditFindingsTables" inverse="true"
			cascade="save-update, delete-orphan" order-by="aud_pc_fp_aud_fdgs_table_id asc">
			<key column="aud_pic_fp_aud_fdgs_id" />
			<one-to-many
				class="com.wo.module.trcAudit.model.TrcAuditPicFollowupAuditFindingsTable" />
		</bag>
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
