<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcCorrespondence.model">
	<class name="TrcCorrespondence" table="wo_trc_correspondence">
		<id name="correspondenceId" column="correspondence_id" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_correspondence_seq</param>
			</generator>
		</id>

		<many-to-one name="sender" property-ref="parameterDtlCode"
			column="sender_code" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
		<property name="letterReceivedDate" column="letter_received_date"
			type="date" />
		<property name="letterNo" column="letter_no" type="string" />
		<property name="letterDate" column="letter_date" type="date" />
		<property name="perihalIn" column="perihal_in" type="string" />
		<property name="perihalEn" column="perihal_en" type="string" />
		<property name="letterSummary" column="letter_summary" type="string" />
		<property name="followUp" column="follow_up" type="string" />
		<property name="notes" column="notes" type="string" />
		<property name="divisionId" column="division_id" type="long" />
		<many-to-one name="userId1" column="user_id_1"
			class="com.wo.module.user.model.User" fetch="join" />
		<many-to-one name="userId2" column="user_id_2"
			class="com.wo.module.user.model.User" fetch="join" />
		<many-to-one name="userId3" column="user_id_3"
			class="com.wo.module.user.model.User" fetch="join" />
		<property name="targetDate" column="target_date" type="date" />
		<many-to-one name="counterType" column="counter_type_id"
			class="com.wo.module.counterType.model.CounterType" fetch="join" />
		<many-to-one name="reminderStatus" property-ref="parameterDtlCode"
			column="reminder_status" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
		<many-to-one name="status" property-ref="parameterDtlCode"
			column="status" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
		<many-to-one name="followupStatus" property-ref="parameterDtlCode"
			column="followup_status" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
		<many-to-one name="picFollowupStatus" property-ref="parameterDtlCode"
			column="pic_followup_status" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />

		<many-to-one name="followupBy" column="followup_by_id"
			class="com.wo.module.user.model.User" fetch="join" />
		<property name="confirmationDate" column="confirmation_date"
			type="date" />
		<property name="followupDate" column="followup_date" type="date" />
		<property name="followupNote" column="followup_note" type="string" />

		<many-to-one name="complianceStatus" property-ref="parameterDtlCode"
			column="compliance_status" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
		
		<many-to-one name="correspondenceCode" property-ref="parameterDtlCode"
			column="correspondence_type" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
		<!-- <property name="complianceStatus" column="compliance_status" type="string" 
			/> -->
		<property name="complianceNote" column="compliance_note"
			type="string" />
		<many-to-one name="complianceBy" column="compliance_by_id"
			class="com.wo.module.user.model.User" fetch="join" />
		<property name="complianceDate" column="compliance_date"
			type="date" />

		<bag name="trcCorrespondenceDocuments" inverse="true"
			cascade="save-update, delete-orphan" order-by="correspondence_attachment_id asc">
			<key column="correspondence_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.trcCorrespondence.model.TrcCorrespondenceDocument" />
		</bag>

		<bag name="trcCorrespondencePicCompliances" inverse="true"
			cascade="save-update, delete-orphan" order-by="correspondence_pic_cmplc_id asc">
			<key column="correspondence_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.trcCorrespondence.model.TrcCorrespondencePicCompliance" />
		</bag>

		<!-- <bag name="trcCorrespondencePicFollowupAttachments" inverse="true"
			cascade="save-update, delete-orphan" order-by="crspdc_pic_fp_atch_id asc">
			<key column="correspondence_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.trcCorrespondence.model.TrcCorrespondencePicFollowupAttachment" />
		</bag> -->

		<bag name="trcCorrespondencePicFollowupEmails" inverse="true"
			cascade="save-update, delete-orphan" order-by="crpdc_pic_fp_email_id asc">
			<key column="correspondence_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.trcCorrespondence.model.TrcCorrespondencePicFollowupEmail" />
		</bag>

		<bag name="trcCorrespondenceSupportingUnits" inverse="true"
			cascade="save-update, delete-orphan" order-by="correspdc_sup_unit_id asc">
			<key column="correspondence_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.trcCorrespondence.model.TrcCorrespondenceSupportingUnit" />
		</bag>
		
		<!-- <bag name="trcCorrespondencePicFollowupAttendance" inverse="true"
			cascade="save-update, delete-orphan" order-by="crpdc_pic_fp_atdee_id asc">
			<key column="correspondence_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.trcCorrespondence.model.TrcCorrespondencePicFollowupAttendance" />
		</bag> -->
		
		<bag name="trcCrpdcPicConfirms" inverse="true"
			cascade="save-update, delete-orphan" order-by="CRPDC_PIC_CONFIRM_ID asc">
			<key column="correspondence_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.trcCorrespondence.model.TrcCrpdcPicConfirm" />
		</bag>
		
		<bag name="trcCrpdcReffLetters" inverse="true"
			cascade="save-update, delete-orphan" order-by="CRPDC_REFF_LETTER_ID asc">
			<key column="correspondence_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.trcCorrespondence.model.TrcCrpdcReffLetter" />
		</bag>

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
		
		<many-to-one name="rc"
			column="RC_ID" class="com.wo.module.rc.model.RC"
			fetch="join" />
		
		<property name="fineDebitted" column="FINE_DEBITTED" type="date" />
		
		<property name="fineAmount" column="FINE_AMOUNT" type="long" />
		
		<property name="breaches" column="BREACHES" type="string" />
		
		<property name="rootCause" column="ROOT_CAUSE" type="string" />
		
		<property name="category" column="CATEGORY" type="string" />
		
		<property name="userMaker" column="USER_MAKER" type="string" />
		
		<property name="userSpv" column="USER_SPV" type="string" />
		
		<property name="noErr" column="NO_ERR" type="string" />

	</class>
</hibernate-mapping>
