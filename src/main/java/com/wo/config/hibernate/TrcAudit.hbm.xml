<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcAudit.model">
	<class name="TrcAudit" table="wo_trc_audit">
		<id name="auditId" column="audit_id" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_audit_seq</param>
			</generator>
		</id>
		<property name="auditor" column="auditor" type="string" />
		<property name="auditObject" column="audit_object" type="string" />
		<property name="auditTopicIn" column="audit_topic_in" type="string" />
		<property name="auditTopicEn" column="audit_topic_en" type="string" />
		<property name="auditCategory" column="audit_category" type="string" />
		<property name="khpDate" column="khp_date" type="date" />
		<property name="auditDateFrom" column="audit_date_from" type="date" />
		<property name="auditDateTo" column="audit_date_to" type="date" />
		<property name="scope" column="scope" type="string" />
		<property name="findingNameIn" column="finding_name_in" type="string" />
		<property name="findingNameEn" column="finding_name_en" type="string" />
		
		<many-to-one name="counterType" column="counter_type_id"
			class="com.wo.module.counterType.model.CounterType" fetch="join" />
		
		<many-to-one name="mstAudit" column="mst_audit_id"
			class="com.wo.module.mstAudit.model.MstAudit" fetch="join" />
		
		<property name="followUp" column="follow_up" type="string" />
		<property name="risk" column="risk" type="string" />
		
		<property name="reminderStatus" column="reminder_status"
			type="string" />

		<many-to-one name="status" property-ref="parameterDtlCode"
			column="STATUS" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />

		<bag name="trcAuditDocuments" inverse="true"
			cascade="save-update, delete-orphan" order-by="audit_document_id asc">
			<key column="audit_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.trcAudit.model.TrcAuditDocument" />
		</bag>

		<bag name="trcAuditPicCompliances" inverse="true"
			cascade="save-update, delete-orphan" order-by="audit_pic_compliance_id asc">
			<key column="audit_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.trcAudit.model.TrcAuditPicCompliance" />
		</bag>
		

		<bag name="trcAuditCheckPoints" inverse="true"
			cascade="save-update, delete-orphan" order-by="AUDIT_CHECK_POINT_ID asc">
			<key column="audit_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.trcAudit.model.TrcAuditCheckPoint" />
		</bag> 
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	</class>
</hibernate-mapping>
