<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.counterType.model">
	<class name="CounterType" table="wo_mst_counter_type">
		<id name="counterTypeId" column="COUNTER_TYPE_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_counter_type_seq</param>
			</generator>
		</id>

		<bag name="details" inverse="true" cascade="save-update, delete-orphan"
			order-by="COUNTER_TYPE_DTL_ID asc">
			<key column="COUNTER_TYPE_ID" />
			<one-to-many not-found="ignore"
				class="com.wo.module.counterType.model.CounterTypeDtl" />
		</bag>

		<property name="counterTypeIn" column="COUNTER_TYPE_IN" type="string" />
		<property name="counterTypeEn" column="COUNTER_TYPE_EN" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	</class>
</hibernate-mapping>
