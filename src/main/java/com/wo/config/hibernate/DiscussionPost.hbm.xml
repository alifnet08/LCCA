<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.discussion.model">
	<class name="DiscussionPost" table="wo_mst_discussion_post">
		<id name="discussionPostId" column="DISCUSSION_POST_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_discussion_post_seq</param>
			</generator>
		</id>

		<many-to-one name="discussion" 
			column="DISCUSSION_ID" class="com.wo.module.discussion.model.Discussion"
			fetch="join" />
			
		<many-to-one name="postedBy" 
			column="POSTED_BY_ID" class="com.wo.module.user.model.User"
			fetch="join" />
			
		<property name="postedDate" column="POSTED_DATE" type="date" />
		<property name="postedComment" column="POSTED_COMMENT" type="string" />
		<property name="postedRating" column="POSTED_RATING" type="double" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
		
		

	</class>
</hibernate-mapping>
