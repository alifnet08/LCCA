<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.mstAudit.model">
	<class name="MstAudit" table="wo_mst_audit">
		<id name="mstAuditId" column="mst_audit_id" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_audit_seq</param>
			</generator>
		</id>

		<property name="auditor" column="auditor" type="string" />
		<property name="auditTemplateIn" column="audit_template_name_in" type="string" />
		<property name="auditTemplateEn" column="audit_template_name_en" type="string" />
		<property name="auditDateFrom" column="audit_date_from" type="date" />
		<property name="auditDateTo" column="audit_date_to" type="date" />
		<property name="scope" column="scope" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />


	</class>
</hibernate-mapping>
