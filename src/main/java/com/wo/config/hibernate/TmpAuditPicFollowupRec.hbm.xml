<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.tmpAudit.model">
	<class name="TmpAuditPicFollowupRec" table="WO_TMP_AUDIT_PIC_FOLLOWUP_REC">
		<id name="auditPicFollowupRecId" column="AUDIT_PIC_FOLLOWUP_REC_ID"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TMP_AUDIT_PIC_FP_REC_SEQ</param>
			</generator>
		</id>

		<many-to-one name="tmpAuditPicFollowup" column="AUDIT_PIC_FOLLOWUP_ID"
			class="com.wo.module.tmpAudit.model.TmpAuditPicFollowup"
			fetch="join" />

		<property name="targetDate" column="target_date" type="date" />
		<property name="rescheduleReason" column="reschedule_reason" type="string" />
		<property name="notes" column="notes" type="string" />
		
		
		<bag name="tmpAuditPicFollowupRecEmails" inverse="true"
			cascade="save-update, delete-orphan" order-by="adt_pic_fp_rec_email_id asc">
			<key column="audit_pic_followup_rec_id" />
			<one-to-many
				class="com.wo.module.tmpAudit.model.TmpAuditPicFollowupRecEmail" />
		</bag>

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
