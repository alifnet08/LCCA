<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.wo.module.trcComplianceReview.model">
	<class name="TrcComplianceReviewPicFollowup" table="wo_trc_cmplc_review_pic_fp">
		<id name="complianceReviewPicFollowupId" column="cmplc_review_pic_followup_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_cmplc_review_pic_fp_seq</param>
			</generator>
		</id>

		<many-to-one name="trcComplianceReview" column="compliance_review_id"
			class="com.wo.module.trcComplianceReview.model.TrcComplianceReview"
			fetch="join" />

		<property name="divisionId" column="division_id" type="long" />

		<many-to-one name="user1" column="user_id_1"
			class="com.wo.module.user.model.User" fetch="join" />
		<many-to-one name="user2" column="user_id_2"
			class="com.wo.module.user.model.User" fetch="join" />
		<many-to-one name="user3" column="user_id_3"
			class="com.wo.module.user.model.User" fetch="join" />

		<property name="targetDate" column="target_date" type="date" />
		
		<many-to-one name="followupStatus" property-ref="parameterDtlCode"
			column="followup_status" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
		<many-to-one name="complianceStatus" property-ref="parameterDtlCode"
			column="compliance_status" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
		<property name="complianceNote" column="compliance_note"
			type="string" />
		<many-to-one name="complianceBy" column="compliance_by_id"
			class="com.wo.module.user.model.User" fetch="join" />
		<property name="complianceDate" column="compliance_date"
			type="date" />
		
			
		<bag name="trcComplianceReviewPicFollowupEmails" inverse="true"
			cascade="delete-orphan" order-by="cmplc_rvw_pic_fp_email_id asc">
			<key column="CMPLC_REVIEW_PIC_FOLLOWUP_ID" />
			<one-to-many
				class="com.wo.module.trcComplianceReview.model.TrcComplianceReviewPicFollowupEmail" />
		</bag>
		
		<bag name="trcComplianceReviewPicFollowupPoints" inverse="true"
			cascade="save-update, delete-orphan" order-by="cmplc_rvw_pic_fp_points_id asc">
			<key column="CMPLC_REVIEW_PIC_FOLLOWUP_ID" />
			<one-to-many
				class="com.wo.module.trcComplianceReview.model.TrcComplianceReviewPicFollowupPoints" />
		</bag>
		
		<bag name="trcComplianceReviewPicFollowupFindings" inverse="true"
			cascade="save-update, delete-orphan" order-by="cmplc_rvw_pic_fp_fdgs_id asc">
			<key column="CMPLC_REVIEW_PIC_FOLLOWUP_ID" />
			<one-to-many
				class="com.wo.module.trcComplianceReview.model.TrcComplianceReviewPicFollowupFindings" />
		</bag>
		
		<bag name="trcComplianceReviewPicFollowupReviews" inverse="true"
			cascade="save-update, delete-orphan" order-by="COMPLIANCE_RVW_PIC_FP_RVW_ID asc">
			<key column="CMPLC_REVIEW_PIC_FOLLOWUP_ID" />
			<one-to-many
				class="com.wo.module.trcComplianceReview.model.TrcComplianceReviewPicFollowupReview" />
		</bag>
		
		<bag name="trcComplianceReviewPicFollowupRegulations" inverse="true"
			cascade="save-update, delete-orphan" order-by="cmplc_rvw_pc_fp_rgltn_id asc">
			<key column="CMPLC_REVIEW_PIC_FOLLOWUP_ID" />
			<one-to-many
				class="com.wo.module.trcComplianceReview.model.TrcComplianceReviewPicFollowupRegulation" />
		</bag>

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
