<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.complianceTestingMockup.model">
	<class name="ComplianceTestingPICFollowup" table="WO_TRC_COMP_TEST_PIC_FP">
		<id name="complianceTestingPICFollowupId" column="COMPLIANCE_TEST_PIC_FP_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TRC_COMP_TEST_PIC_FP_SEQ</param>
			</generator>
		</id>

		<many-to-one name="complianceTestingDtl" column="COMPLIANCE_TESTING_DTL_ID"
			class="com.wo.module.complianceTestingMockup.model.ComplianceTestingDtl" fetch="join" />
			
		<property name="divisionId" column="DIVISION_ID" type="long" />
		<property name="branchCode" column="BRANCH_CODE" type="string" />
		
		<many-to-one name="user1" column="user_id_1"
			class="com.wo.module.user.model.User" fetch="join" />
			
		<many-to-one name="user2" column="user_id_2"
			class="com.wo.module.user.model.User" fetch="join" />
			
		<many-to-one name="user3" column="user_id_3"
			class="com.wo.module.user.model.User" fetch="join" />
			
		<property name="targetDate" column="TARGET_DATE" type="date" />
		<property name="followup" column="FOLLOWUP" type="string" />
		
		<many-to-one name="followupStatus" property-ref="parameterDtlCode"
			column="FOLLOWUP_STATUS" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
		<property name="followupById" column="FOLLOWUP_BY_ID" type="long" />
		<property name="confirmationDate" column="CONFIRMATION_DATE" type="date" />
		<property name="followupDate" column="FOLLOWUP_DATE" type="date" />
		<property name="followupNote" column="FOLLOWUP_NOTE" type="string" />
		<many-to-one name="complianceStatus" property-ref="parameterDtlCode"
			column="COMPLIANCE_STATUS" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
		<property name="complianceNote" column="COMPLIANCE_NOTE" type="string" />
		<property name="complianceById" column="COMPLIANCE_BY_ID" type="long" />
		<property name="complianceDate" column="COMPLIANCE_DATE" type="date" />
		<property name="rescheduleReason" column="RESCHEDULE_REASON" type="string" />
		<property name="isExtension" column="EXTENSION_FLAG" type="string" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
		
		<bag name="complianceTestingPicFollowupAttachs" inverse="true" cascade="save-update, delete-orphan"
			order-by="COMP_TEST_PIC_FP_ATTACH_ID asc">
			<key column="COMPLIANCE_TEST_PIC_FP_ID" />
			<one-to-many not-found="ignore"
				class="com.wo.module.complianceTestingMockup.model.ComplianceTestingPICFollowupAttachment" />
		</bag>
		
		<bag name="complianceTestingPicFollowupExts" inverse="true" cascade="save-update, delete-orphan"
			order-by="COMP_TEST_PIC_FP_EXT_ID asc">
			<key column="COMPLIANCE_TEST_PIC_FP_ID" />
			<one-to-many not-found="ignore"
				class="com.wo.module.complianceTestingMockup.model.ComplianceTestingPICFollowupExt" />
		</bag>

		<bag name="complianceTestingPicFollowupEmails" inverse="true" cascade="save-update, delete-orphan"
			order-by="COMP_TEST_PIC_FP_EMAIL_ID asc">
			<key column="COMPLIANCE_TEST_PIC_FP_ID" />
			<one-to-many not-found="ignore"
				class="com.wo.module.complianceTestingMockup.model.ComplianceTestingPICFollowupEmail" />
		</bag>
	</class>
</hibernate-mapping>
