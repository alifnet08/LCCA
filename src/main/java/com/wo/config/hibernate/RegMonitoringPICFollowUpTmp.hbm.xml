<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping
	package="com.wo.module.regulationMonitoring.model">
	<class name="RegMonitoringPICFollowUpTmp"
		table="WO_TMP_REG_MONITORING_PIC_FP">
		<id name="regMonitoringPicFollowUpTmpId"
			column="REG_MONITORING_PIC_FOLLOWUP_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TMP_REG_MONITOR_PIC_FP_SQ</param>
			</generator>
		</id>

		<many-to-one name="regMonitoringTmp"
			column="REG_MONITORING_ID"
			class="com.wo.module.regulationMonitoring.model.RegMonitoringTmp"
			fetch="join" />

		<property name="divisionId" column="division_id" type="long" />

		<many-to-one name="user1" column="user_id_1"
			class="com.wo.module.user.model.User" fetch="join" />
		<many-to-one name="user2" column="user_id_2"
			class="com.wo.module.user.model.User" fetch="join" />
		<many-to-one name="user3" column="user_id_3"
			class="com.wo.module.user.model.User" fetch="join" />

		<property name="targetDate" column="target_date" type="date" />
		<property name="rescheduleReason" column="reschedule_reason"
			type="string" />
		<property name="notes" column="notes" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
		
		<bag name="regMonitoringPICFollowUpEmailTmps" inverse="true"
			cascade="save-update, delete-orphan"
			order-by="REG_MONITORING_PIC_FP_EMAIL_ID asc">
			<key column="REG_MONITORING_PIC_FOLLOWUP_ID" />
			<one-to-many
				class="com.wo.module.regulationMonitoring.model.RegMonitoringPICFollowUpEmailTmp" />
		</bag>

		<bag name="regMonitoringPICFollowUpAttachmentTrcs" inverse="true"
			cascade="save-update, delete-orphan"
			order-by="REG_MONITOR_PIC_FP_ATCH_ID asc">
			<key column="REG_MONITORING_PIC_FOLLOWUP_ID" />
			<one-to-many
				class="com.wo.module.regulationMonitoring.model.RegMonitoringPICFollowUpAttachmentTrc" />
		</bag>

	</class>
</hibernate-mapping>