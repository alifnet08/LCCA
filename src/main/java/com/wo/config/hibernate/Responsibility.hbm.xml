<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.responsibility.model">
	<class name="Responsibility" table="wo_mst_responsibility">
		<id name="responsibilityId" column="RESPONSIBILITY_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_responsibility_seq</param>
			</generator>
		</id>

		<property name="name" column="NAME" type="string" />

		<property name="description" column="DESCRIPTION" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

		<bag name="details" inverse="true" cascade="save-update, delete-orphan"
			order-by="RESPONSIBILITY_DTL_ID asc">
			<key column="RESPONSIBILITY_ID" />
			<one-to-many not-found="ignore"
				class="com.wo.module.responsibility.model.ResponsibilityDetail" />
		</bag>

	</class>
</hibernate-mapping>
