<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.notary.model">
	<class name="Notary" table="wo_mst_notary">
		<id name="notaryId" column="NOTARY_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_notary_seq</param>
			</generator>
		</id>

		<many-to-one name="notaryCategory" property-ref="parameterDtlCode"
			column="NOTARY_CATEGORY" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
			
		<property name="area" column="AREA" type="string" />
		
		<property name="notaryName" column="NOTARY_NAME" type="string" />
		<property name="address" column="ADDRESS" type="string" />
		<property name="areaCode" column="AREA_CODE" type="string" />
		<property name="phoneNo" column="PHONE_NO" type="string" />
		<property name="faxNo" column="FAX_NO" type="string" />
		<property name="email" column="EMAIL" type="string" />
		<property name="mobileNo" column="MOBILE_NO" type="string" />
		<property name="workArea" column="WORK_AREA" type="string" />
		<property name="note" column="NOTE" type="string" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
		
		

	</class>
</hibernate-mapping>
