<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.log.model">
	<class name="LogDetail" table="wo_trc_log_d">
		<composite-id>
			<key-many-to-one name="logHeader"
				class="com.wo.module.log.model.LogHeader" column="PROCESS_ID" />
			<key-property name="seqNo" type="long" column="SEQ_NO" />
		</composite-id>

		<property name="msgType" column="MSG_TYPE" type="string" />
		<property name="msgLocation" column="MSG_LOCATION" type="string" />
		<property name="msgMessage" column="MSG_DETAIL" type="string" />
		<property name="msgDate" column="MSG_DT" type="timestamp" />
	</class>
</hibernate-mapping>
