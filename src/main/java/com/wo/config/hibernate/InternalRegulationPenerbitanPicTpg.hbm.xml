<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.internalRegulationPenerbitan.model">
	<class name="InternalRegulationPenerbitanPicTpg" table="wo_trc_irg_pic_tpg">
		<id name="irgPicId" column="IRG_PIC_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_irg_pic_tpg_seq</param>
			</generator>
		</id>
		
		<many-to-one name="irg" column="IRG_ID" fetch="join" 
				class="com.wo.module.internalRegulationPenerbitan.model.InternalRegulationPenerbitan" />
		
		<property name="divisionId" column="division_id" type="long" />
		
		<many-to-one name="user1" column="user_id_1"
			class="com.wo.module.user.model.User" fetch="join" />
		<many-to-one name="user2" column="user_id_2"
			class="com.wo.module.user.model.User" fetch="join" />
		<many-to-one name="user3" column="user_id_3"
			class="com.wo.module.user.model.User" fetch="join" />

		<property name="targetDate" column="target_date" type="date" />
		
		<property name="note" column="note" type="string" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />		
				
		<bag name="internalRegulationPenerbitanPicTpgEmailList" inverse="true"
			cascade="save-update, delete-orphan" order-by="irg_pic_tpg_email_id asc">
			<key column="irg_pic_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.internalRegulationPenerbitan.model.InternalRegulationPenerbitanPicTpgEmail" />
		</bag>
		
	</class>
</hibernate-mapping>
                   
                 
  
  