<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.dbCompliance.model">
	<class name="DBCompliance" table="WO_MST_DATABASE_COMPLIANCE">
		<id name="databaseComplianceId" column="DATABASE_COMPLIANCE_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_MST_DB_COMPLIANCE_SEQ</param>
			</generator>
		</id>

		<many-to-one name="reportType" 
			column="REPORT_TYPE_ID" class="com.wo.module.reportType.model.ReportType"
			fetch="join" />
			
		
		<property name="reportNameIn" column="REPORT_NAME_IN" type="string" />
		<property name="reportNameEn" column="REPORT_NAME_EN" type="string" />
		<property name="description" column="DESCRIPTION" type="string" />
		<property name="note" column="NOTE" type="string" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
		
		<bag name="dbComplianceDuedates" inverse="true"
			cascade="save-update, delete-orphan" order-by="db_compliance_due_date_id asc">
			<key column="database_compliance_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.dbCompliance.model.DBComplianceDueDate" />
		</bag>
		
		<bag name="dbComplianceDocs" inverse="true"
			cascade="save-update, delete-orphan" order-by="db_compliance_document_id asc">
			<key column="database_compliance_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.dbCompliance.model.DBComplianceDoc" />
		</bag>

	</class>
</hibernate-mapping>
