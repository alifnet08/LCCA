<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.report.reportGen.model">
    <class name="ReportGen" table="wo_trc_report_gen">
        <id name="reportGenId" column="report_gen_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_report_gen_seq</param>
			</generator>
		</id>
        
        <property name="reportGenNik" column="nik" type="string" />
		<property name="reportGenEmployeeName" column="employee_name" type="string" />
		<property name="reportGenReportName" column="report_name" type="string" />
		<property name="reportGenStatus" column="status" type="string" />
		<property name="reportGenStatusMsg" column="status_msg" type="string" />
		<property name="reportGenFileId" column="report_file_id" type="string" />
		<property name="reportGenFileSize" column="file_size" type="long" />
		<property name="reportGenFile" column="report_file" type="string" lazy="true" />
		<property name="reportGenReportFileName" column="report_file_name" type="string" />
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />     
		
    </class>
</hibernate-mapping>
