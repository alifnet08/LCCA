<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.regulationSocialization.model">
	<class name="SocializationPICFollowupTmp" table="wo_tmp_socialization_pic_fp">
		<id name="socializationPicFollowupId" column="socialization_pic_followup_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TMP_SOCIALIZATION_PIC_FP_SQ</param>
			</generator>
		</id>

		<many-to-one name="socialization" column="socialization_id"
			class="com.wo.module.regulationSocialization.model.SocializationTmp"
			fetch="join" />

		<property name="divisionId" column="division_id" type="long" />
		<!-- <many-to-one name="division" column="division_id" class="com.wo.module.user.model.Division" 
			fetch="join" /> -->

		<many-to-one name="user1" column="user_id_1"
			class="com.wo.module.user.model.User" fetch="join" />
		<many-to-one name="user2" column="user_id_2"
			class="com.wo.module.user.model.User" fetch="join" />
		<many-to-one name="user3" column="user_id_3"
			class="com.wo.module.user.model.User" fetch="join" />

		<property name="targetDate" column="target_date" type="date" />
		<property name="rescheduleReason" column="reschedule_reason" type="string" />
		<property name="notes" column="notes" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

		<bag name="socializationPICFollowupEmailTmps" inverse="true"
			cascade="delete-orphan" order-by="socialization_pic_fp_email_id asc">
			<key column="socialization_pic_followup_id" />
			<one-to-many
				class="com.wo.module.regulationSocialization.model.SocializationPICFollowupEmailTmp" />
		</bag>

	</class>
</hibernate-mapping>
