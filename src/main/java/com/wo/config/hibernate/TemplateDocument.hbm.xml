<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.template.model">
	<class name="TemplateDocument" table="wo_mst_template_document">
		<id name="templateDocumentId" column="TEMPLATE_DOCUMENT_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_template_document_seq</param>
			</generator>
		</id>

		<many-to-one name="template" 
			column="TEMPLATE_ID" class="com.wo.module.template.model.Template"
			fetch="join" />
			
		<property name="attachmentFile" column="ATTACHMENT_FILE" type="string" />
		<property name="fileId" column="FILE_ID" type="string" />
		<property name="fileSize" column="FILE_SIZE" type="long" />
		<property name="documentType" column="DOCUMENT_TYPE" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	</class>
</hibernate-mapping>
