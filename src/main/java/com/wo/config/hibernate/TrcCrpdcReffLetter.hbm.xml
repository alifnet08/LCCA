<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcCorrespondence.model">
	<class name="TrcCrpdcReffLetter" table="WO_TRC_CRPDC_REFF_LETTER">
		<id name="crpdcReffLetterId" column="CRPDC_REFF_LETTER_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TRC_CRPDC_REFF_LETTER_SEQ</param>
			</generator>
		</id>
		
		<many-to-one name="trcCorrespondence" column="CORRESPONDENCE_ID" fetch="join" 
				class="com.wo.module.trcCorrespondence.model.TrcCorrespondence" />
				
		<many-to-one name="reffLetterCorrespondence" column="REFF_LETTER_CRPDC_ID" fetch="join" 
				class="com.wo.module.trcCorrespondence.model.TrcCorrespondence" />
				
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	</class>
</hibernate-mapping>
