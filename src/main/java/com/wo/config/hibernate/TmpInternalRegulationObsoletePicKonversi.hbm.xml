<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.internalRegulationObsolete.model">
	<class name="InternalRegulationObsoletePic" table="wo_tmp_obsolete_int_reg_pic">
		<id name="internalRegObsoletePicKonvId" column="obsolete_reg_pic_id" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_tmp_obs_int_reg_pic_seq</param>
			</generator>
		</id>

		<many-to-one name="internalRegulasiObsolete"
			column="obsolete_regulation_id" 
			class="com.wo.module.internalRegulationObsolete.model.InternalRegulationObsolete"
			fetch="join" />
			
		<many-to-one name="division" column="division_id" 
			class="com.wo.module.division.model.Division" 
			fetch="join" />

		<many-to-one name="user1" column="USER_ID_1"
			class="com.wo.module.user.model.User"
			fetch="join" />
			
		<many-to-one name="user2" column="USER_ID_2"
			class="com.wo.module.user.model.User"
			fetch="join" />
			
		<many-to-one name="user3" column="USER_ID_3"
			class="com.wo.module.user.model.User"
			fetch="join" />
			
		<property name="targetDate" column="target_date_conv" type="date" />
		<property name="notes" column="notes" type="string" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	</class>
</hibernate-mapping>
