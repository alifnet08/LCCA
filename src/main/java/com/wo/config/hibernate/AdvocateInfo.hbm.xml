<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.advocate.model">
	<class name="AdvocateInfo" table="wo_mst_advocate_info">
		<id name="advocateInfoId" column="ADVOCATE_INFO_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_advocate_info_seq</param>
			</generator>
		</id>

		<many-to-one name="advocate" 
			column="ADVOCATE_ID" class="com.wo.module.advocate.model.Advocate"
			fetch="join" />
			
		<property name="officeAddress" column="OFFICE_ADDRESS" type="string" />
		<property name="phoneNo" column="PHONE_NO" type="string" />
		<property name="faxNo" column="FAX_NO" type="string" />
		<property name="email" column="EMAIL" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	</class>
</hibernate-mapping>
