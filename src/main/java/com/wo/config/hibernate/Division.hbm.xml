<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.division.model">
	<class name="Division" table="wo_mst_division">
		<id name="divisionId" column="DIVISION_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_division_seq</param>
			</generator>
		</id>

		<property name="divisionName" column="DIVISION_NAME" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		
	</class>
</hibernate-mapping>
