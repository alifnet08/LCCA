<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.regulationMonitoring.model">
	<class name="RegMonitoringPICFollowUpRescheduleTmp" table="WO_TMP_REG_MONITOR_PIC_FP_RSCH">
		<id name="regMonitoringPicFollowUpRescheduleTmpId" column="REG_MONITORING_PIC_FP_RSCHD_ID"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TMP_REG_MON_PIC_FP_RSCH_SQ</param>
			</generator>
		</id>

		<many-to-one name="regMonitoringPicFollowUpTmp" column="REG_MONITORING_PIC_FOLLOWUP_ID"
			class="com.wo.module.regulationMonitoring.model.RegMonitoringPICFollowUpTmp"
			fetch="join" />

		<property name="oldTargetDate" column="old_target_date" type="date" />
		<property name="newTargetDate" column="new_target_date" type="date" />

		<property name="rescheduleReason" column="RESCHEDULE_REASON" type="string" />
		
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		
		<property name="delId" column="DEL_ID" type="long" />
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
	</class>
</hibernate-mapping>
