<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.complianceTestingMockup.model">
	<class name="ComplianceTestingDtl" table="WO_TRC_COMPLIANCE_TESTING_DTL">
		<id name="complianceTestingDtlId" column="COMPLIANCE_TESTING_DTL_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TRC_COMPLIANCE_TEST_DTL_SEQ</param>
			</generator>
		</id>

		<many-to-one name="complianceTesting" column="COMPLIANCE_TESTING_ID"
			class="com.wo.module.complianceTestingMockup.model.ComplianceTesting" fetch="join" />
			
		<property name="subject" column="SUBJECT" type="string" />
		<property name="rating" column="RATING" type="string" />
		
		<property name="observationResults" column="OBSERVATION_RESULTS" type="string" />
		<property name="recommendation" column="RECOMMENDATION" type="string" />
		<property name="isFollowup" column="FOLLOWUP" type="string" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
		
		
		<bag name="complianceTestingPICFollowups" inverse="true" cascade="save-update, delete-orphan"
			order-by="COMPLIANCE_TEST_PIC_FP_ID asc">
			<key column="COMPLIANCE_TESTING_DTL_ID" />
			<one-to-many not-found="ignore"
				class="com.wo.module.complianceTestingMockup.model.ComplianceTestingPICFollowup" />
		</bag>

	</class>
</hibernate-mapping>
