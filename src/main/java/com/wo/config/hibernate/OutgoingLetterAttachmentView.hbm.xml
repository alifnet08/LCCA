<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.outgoingLetterView.model">
	<class name="OutgoingLetterAttachmentView" table="wo_mst_outgoing_letter_attach">
		<id name="outgoingLetterAttachmentId" column="outgoing_letter_attachment_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_MST_OUTGOING_LTR_ATTACH_SQ</param>
			</generator>
		</id>

		<many-to-one name="outgoingLetterView" column="outgoing_letter_id"
			class="com.wo.module.outgoingLetterView.model.OutgoingLetterView"
			fetch="join" />

		<property name="attachmentFile" column="attachment_file"
			type="string" />
			
		<property name="attachmentType" column="attachment_type"
			type="string" />
			
		<property name="fileId" column="file_id"
			type="string" />
		<property name="fileSize" column="file_size" type="long" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />


	</class>
</hibernate-mapping>
