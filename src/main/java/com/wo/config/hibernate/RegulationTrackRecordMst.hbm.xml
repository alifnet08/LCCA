<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.externalRegulation.model">
	<class name="RegulationTrackRecordMst" table="wo_mst_regulation_track_record">
		<id name="regulationTrackRecordId" column="regulation_track_record_id"
			type="long">
		</id>

		<many-to-one name="regulationMst" column="regulation_id"
			class="com.wo.module.externalRegulation.model.RegulationMst" fetch="join" />

		<property name="trackCode" column="track_code" type="string" />

		<property name="regulationLinkId" column="regulation_link_id" type="long" />
		<property name="regulationLinkName" column="regulation_link_name" type="string" />

		<property name="trackNote" column="track_note" type="string" />
		
		<property name="inActiveFlag" column="inactive_flag" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />


	</class>
</hibernate-mapping>
