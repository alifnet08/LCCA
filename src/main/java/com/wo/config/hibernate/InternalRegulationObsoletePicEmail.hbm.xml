<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.internalRegulationObsolete.model">
	<class name="InternalRegulationObsoleteEmailTmp" table="wo_trc_irg_obs_pic_email">
		<id name="internalRegulationObsoleteEmailId" column="obs_pic_email_id" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_irg_obs_pic_konv_seq</param>
			</generator>
		</id>
		
		<many-to-one name="irgObsoletePic" column="konv_pic_id"
			class="com.wo.module.internalRegulationObsolete.model.InternalRegulationObsoletePic"
			fetch="join" />
			
		<property name="emailDate" column="email_date" type="date" />
		<property name="emailStatus" column="email_status" type="string" />
		<property name="emailSubject" column="email_subject" type="string" />
		<property name="emailContent" column="email_content" type="string" />
		
		<property name="slaType" column="sla_type" type="string"/>
		<property name="sla" column="SLA" type="integer"/>
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	</class>
</hibernate-mapping>
