<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcLock.model">
	<class name="TrcLock" table="wo_trc_lock">
		<id name="lockId" type="long">
			<column name="LOCK_ID" />
			<generator class="sequence">
				<param name="sequence_name">wo_trc_lock_seq</param>
			</generator>
		</id>
		

		<many-to-one name="user" column="USER_ID" class="com.wo.module.user.model.User" fetch="join" />

		<property name="lockModule" column="LOCK_MODULE" type="string" />
		<property name="startDate" column="START_DATE" type="timestamp" />
		<property name="endDate" column="END_DATE" type="timestamp" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE" type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
		
	</class>
</hibernate-mapping>
