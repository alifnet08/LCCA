<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcComplianceReview.model">
	<class name="TrcComplianceReviewPicFollowupReview" table="wo_trc_cmplc_rvw_pc_fp_review">
		<id name="complianceReviewPicFollowupReviewId" column="COMPLIANCE_RVW_PIC_FP_RVW_ID"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_cmplc_rvw_pc_fp_rvw_seq</param>
			</generator>
		</id>

		<many-to-one name="trcComplianceReviewPicFollowup" column="cmplc_review_pic_followup_id"
			class="com.wo.module.trcComplianceReview.model.TrcComplianceReviewPicFollowup"
			fetch="join" />

		<property name="areaReview" column="area_review" type="string" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
