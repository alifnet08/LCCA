<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.regulationSocialization.model">
	<class name="SocializationPICFollowupRescheduleTrc" table="wo_trc_socialization_pic_fp_reschedule">
		<id name="socializationPicFollowupRescheduleId" column="socialization_pic_followup_reschedule_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TRC_SCLZTN_PIC_FP_RSCHDL_SQ</param>
			</generator>
		</id>

		<many-to-one name="socializationPICFollowupTrc" column="socialization_pic_followup_id"
			class="com.wo.module.regulationSocialization.model.SocializationPICFollowupTrc"
			fetch="join" />

		<property name="oldTargetDate" column="old_target_date" type="date" />
		<property name="newTargetDate" column="new_target_date" type="date" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />


	</class>
</hibernate-mapping>
