<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.parameter.model">
	<class name="ParameterDetail" table="wo_mst_parameter_dtl">
		<id name="parameterDtlId" column="PARAMETER_DTL_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_parameter_dtl_seq</param>
			</generator>
		</id>

		<many-to-one name="parameterHeader" column="PARAMETER_CODE"
			class="com.wo.module.parameter.model.ParameterHeader" property-ref="parameterCode"
			fetch="join">
		</many-to-one>

		<property name="parameterDtlCode" column="PARAMETER_DTL_CODE"
			type="string" />

		<property name="nameIn" column="NAME_IN" type="string" />
		<property name="nameEn" column="NAME_EN" type="string" />
		<property name="passiveParameterId" column="passive_parameter_id"
			type="long" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />


	</class>
</hibernate-mapping>
