<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.tmpComplianceReview.model">
	<class name="TmpComplianceReviewPicCompliance" table="wo_tmp_comp_rvw_pic_comp">
		<id name="complianceReviewPicComplianceId" column="comp_review_pic_comp_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TMP_CMP_RVW_PC_CMP_SQ</param>
			</generator>
		</id>

		<many-to-one name="tmpComplianceReview" column="compliance_review_id"
			class="com.wo.module.tmpComplianceReview.model.TmpComplianceReview"
			fetch="join" />

		<many-to-one name="user" column="user_id"
			class="com.wo.module.user.model.User" fetch="join" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />


	</class>
</hibernate-mapping>
