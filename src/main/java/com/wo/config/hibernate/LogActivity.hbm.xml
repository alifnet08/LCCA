<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.logActivity.model">
	<class name="LogActivity" table="wo_log_activity">
		<id name="logActivityId" column="LOG_ACTIVITY_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_log_activity_seq</param>
			</generator>
		</id>

		<many-to-one name="user" 
			column="USER_ID" class="com.wo.module.user.model.User"
			fetch="join" />
		<property name="activityType" column="ACTIVITY_TYPE" type="string" />
		<property name="activityDate" column="ACTIVITY_DATE" type="timestamp" />
		<property name="activityNote" column="ACTIVITY_NOTE" type="string" />
		
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	</class>
</hibernate-mapping>