<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcAudit.model">
	<class name="TrcAuditPicFollowupBankCommitment" table="wo_trc_audit_pc_fp_bank_cmitmt">
		<id name="auditPicFollowupBankCommitmentId" column="aud_pc_fp_bank_cmitmt_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_audit_pc_fp_bank_cm_sq</param>
			</generator>
		</id>

		<many-to-one name="trcAuditCheckPoint" column="AUDIT_CHECK_POINT_ID"
			class="com.wo.module.trcAudit.model.TrcAuditCheckPoint"
			fetch="join" />

		<property name="bankCommitment" column="bank_commitment" type="string" />
		
		<property name="isRecurr" column="recurring_flag" type="string" />
		
		<property name="recurringType" column="recurring_type" type="string" />
		
		<property name="recurringEndDate" column="recurring_end_date" type="date" />
		
		<bag name="trcAuditPicFollowups" inverse="true"
			cascade="delete-orphan" order-by="audit_pic_followup_id asc">
			<key column="aud_pc_fp_bank_cmitmt_id" />
			<one-to-many
				class="com.wo.module.trcAudit.model.TrcAuditPicFollowup" />
		</bag>

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
