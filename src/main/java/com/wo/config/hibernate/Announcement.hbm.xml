<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.announcement.model">
	<class name="Announcement" table="wo_mst_announcement">
		<id name="announcementId" column="ANNOUNCEMENT_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_announcement_seq</param>
			</generator>
		</id>
		
		<property name="announcementTitle" column="ANNOUNCEMENT_TITLE" type="string" />
		<property name="periodStart" column="PERIOD_START" type="date" />
		<property name="periodEnd" column="PERIOD_END" type="date" />
		<property name="announcementContent" column="ANNOUNCEMENT_CONTENT" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
		
	</class>
</hibernate-mapping>
