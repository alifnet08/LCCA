<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.tmpComplianceReview.model">
	<class name="TmpComplianceReviewPicFollowupFindings" table="wo_tmp_cmplc_rvw_pc_fp_find">
		<id name="complianceReviewPicFollowupFindingsId" column="compliance_rvw_pc_fp_find_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TMP_CMPL_RVW_PC_FP_FND_SQ</param>
			</generator>
		</id>

		<many-to-one name="tmpComplianceReviewPicFolllowup" column="compliance_rvw_pic_fp_id"
			class="com.wo.module.tmpComplianceReview.model.TmpComplianceReviewPicFollowup"
			fetch="join" />

		<property name="findings" column="findings" type="string" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
