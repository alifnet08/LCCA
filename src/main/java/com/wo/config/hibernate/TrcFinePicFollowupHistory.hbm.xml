<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcFineApproval.model">
	<class name="TrcFinePicFollowupHistory" table="WO_TRC_FINE_PIC_FOLLOWUP_HIS">
		<id name="finePicFollowupHistoryId" column="FINE_PIC_FP_HIS_ID"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TRC_FINE_PIC_FP_HIS_SEQ</param>
			</generator>
		</id>

		<many-to-one name="trcFinePicFollowup" column="FINE_PIC_FP_ID"
			class="com.wo.module.trcFineApproval.model.TrcFinePicFollowup"
			fetch="join" />
			
		<many-to-one name="rc" column="rc_id"
			class="com.wo.module.rc.model.RC"
			fetch="join" />
			
		<property name="fineDebitted" column="FINE_DEBITTED" type="date" />
		<property name="fineAmount" column="FINE_AMOUNT" type="long" />
		<property name="breaches" column="BREACHES" type="string" />
		<property name="rootCause" column="ROOT_CAUSE" type="string" />
		<property name="category" column="CATEGORY" type="string" />
		<property name="targetDate" column="TARGET_DATE" type="date" />
		<property name="targetResponseDate" column="TARGET_RESPONSE_DATE" type="date" />
		<property name="divisionId" column="DIVISION_ID" type="long" />
		
		<property name="rescheduleReason" column="RESCHEDULE_REASON" type="string" />
		<property name="notes" column="NOTES" type="string" />
		
		<many-to-one name="followupStatus" property-ref="parameterDtlCode"
			column="FOLLOWUP_STATUS" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
			
		<many-to-one name="targetDateStatus" property-ref="parameterDtlCode"
			column="TARGET_DATE_STATUS" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
			
		<many-to-one name="followupBy" column="FOLLOWUP_BY_ID"
			class="com.wo.module.user.model.User"
			fetch="join" />
			
		<property name="confirmationDate" column="CONFIRMATION_DATE" type="date" />
		<property name="followupDate" column="FOLLOWUP_DATE" type="date" />
		<property name="followupNote" column="FOLLOWUP_NOTE" type="string" />
		
		<many-to-one name="complianceStatus" property-ref="parameterDtlCode"
			column="COMPLIANCE_STATUS" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
			
		<property name="complianceNote" column="COMPLIANCE_NOTE" type="string" />
		
		<many-to-one name="complianceBy" column="COMPLIANCE_BY_ID"
			class="com.wo.module.user.model.User"
			fetch="join" />
			
		<property name="complianceDate" column="COMPLIANCE_DATE" type="date" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
		
	</class>
</hibernate-mapping>
