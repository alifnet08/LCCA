<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.complianceTestingMockup.model">
	<class name="ComplianceTesting" table="WO_TRC_COMPLIANCE_TESTING">
		<id name="complianceTestingId" column="COMPLIANCE_TESTING_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TRC_COMPLIANCE_TESTING_SEQ</param>
			</generator>
		</id>

		<property name="inspectionTitle" column="INSPECTION_TITLE" type="string" />
		<property name="inspectionNo" column="INSPECTION_NO" type="string" />
		<property name="startDate" column="START_DATE" type="date" />
		<property name="endDate" column="END_DATE" type="date" />
		
		
		<property name="notes" column="NOTES" type="string" />
		<many-to-one name="counterType" column="counter_type_id"
			class="com.wo.module.counterType.model.CounterType" fetch="join" />
		<property name="reminderStatus" column="REMINDER_STATUS" type="string" />
		<property name="status" column="STATUS" type="string" />
		<property name="overallRating" column="OVERALL_RATING" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
		
		<bag name="complianceTestingDtls" inverse="true" cascade="save-update, delete-orphan"
			order-by="COMPLIANCE_TESTING_DTL_ID asc">
			<key column="COMPLIANCE_TESTING_ID" />
			<one-to-many not-found="ignore"
				class="com.wo.module.complianceTestingMockup.model.ComplianceTestingDtl" />
		</bag>
		
		
		<bag name="complianceTestingDocs" inverse="true" cascade="save-update, delete-orphan"
			order-by="COMP_TESTING_ATTACH_ID asc">
			<key column="COMPLIANCE_TESTING_ID" />
			<one-to-many not-found="ignore"
				class="com.wo.module.complianceTestingMockup.model.ComplianceTestingDoc" />
		</bag>
		
		<bag name="complianceTestingPICReviews" inverse="true" cascade="save-update, delete-orphan"
			order-by="COMP_TEST_PIC_RVW_ID asc">
			<key column="COMPLIANCE_TESTING_ID" />
			<one-to-many not-found="ignore"
				class="com.wo.module.complianceTestingMockup.model.ComplianceTestingPICReview" />
		</bag>
		
		

	</class>
</hibernate-mapping>
