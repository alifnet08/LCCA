<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.internalRegulationObsolete.model">
	<class name="InternalRegulationObsoletePic" table="wo_trc_irg_obsolete_pic_konv">
		<id name="internalRegObsoletePicKonvId" column="konv_pic_id" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_irg_obs_pic_konv_seq</param>
			</generator>
		</id>

		<many-to-one name="internalRegulasiObsolete"
			column="irg_obsolete_id" 
			class="com.wo.module.internalRegulationObsolete.model.InternalRegulationObsolete"
			fetch="join" />
			
		<many-to-one name="division" column="division_id" 
			class="com.wo.module.division.model.Division" 
			fetch="join" />

		<many-to-one name="user1" column="USER_ID_1"
			class="com.wo.module.user.model.User"
			fetch="join" />
			
		<many-to-one name="user2" column="USER_ID_2"
			class="com.wo.module.user.model.User"
			fetch="join" />
			
		<many-to-one name="user3" column="USER_ID_3"
			class="com.wo.module.user.model.User"
			fetch="join" />
			
		<bag name="regulationObsoleteEmailTmps" inverse="true"
			cascade="save-update, delete-orphan" order-by="obs_pic_email_id asc">
			<key column="konv_pic_id" />
			<one-to-many
				class="com.wo.module.internalRegulationObsolete.model.InternalRegulationObsoleteEmailTmp" />
		</bag>
			
		<property name="targetDate" column="target_date_konv" type="date" />
		<property name="notes" column="notes" type="string" />
		<property name="sendEmailFlag" column="send_email_flag" type="string" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	</class>
</hibernate-mapping>
