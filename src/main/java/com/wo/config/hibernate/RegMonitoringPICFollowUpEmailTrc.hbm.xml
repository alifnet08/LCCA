<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.regulationMonitoring.model">
	<class name="RegMonitoringPICFollowUpEmailTrc" table="WO_TRC_REG_MONITOR_PC_FP_EMAIL">
		<id name="regMonitoringPicFollowUpEmailTrcId" column="REG_MONITORING_PIC_FP_EMAIL_ID"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TRC_REG_MON_PC_FP_EMAIL_SQ</param>
			</generator>
		</id>

		<many-to-one name="regMonitoringPicFollowUpTrc" column="REG_MONITORING_PIC_FOLLOWUP_ID"
			class="com.wo.module.regulationMonitoring.model.RegMonitoringPICFollowUpTrc"
			fetch="join" />


		<property name="emailDate" column="email_date" type="date" />
		<property name="slaType" column="sla_type" type="string" />
		<property name="sla" column="sla" type="long" />
		
		<property name="emailStatus" column="email_status" type="string" />
		<property name="emailSubject" column="email_subject" type="string" />
		<property name="emailContent" column="email_content" type="string" />
		
		<property name="resendCount" column="resend_count" type="integer" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
