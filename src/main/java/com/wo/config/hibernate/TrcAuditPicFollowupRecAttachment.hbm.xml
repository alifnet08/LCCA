<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcAudit.model">
	<class name="TrcAuditPicFollowupRecAttachment" table="wo_trc_audit_pic_fp_rec_atch">
		<id name="auditPicFollowupRecAttachmentId" column="audit_pic_followup_rec_atch_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TRC_AUDIT_PIC_FP_REC_A_SEQ</param>
			</generator>
		</id>

		<many-to-one name="trcAuditPicFollowupRec" column="audit_pic_followup_rec_id"
			class="com.wo.module.trcAudit.model.TrcAuditPicFollowupRec"
			fetch="join" />
		
		<many-to-one name="attachmentType" property-ref="parameterDtlCode"
			column="ATTACHMENT_TYPE" class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />
			
		<property name="attachmentFile" column="ATTACHMENT_FILE"
			type="string" />
		
		<property name="fileId" column="FILE_ID" type="string" />
		<property name="fileSize" column="file_size" type="long" />
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
