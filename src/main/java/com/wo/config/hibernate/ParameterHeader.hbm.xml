<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.parameter.model">
	<class name="ParameterHeader" table="wo_mst_parameter">
		<id name="parameterId" column="PARAMETER_ID" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_parameter_seq</param>
			</generator>
		</id>

		<bag name="listDetail" inverse="true" cascade="save-update, delete-orphan"
			order-by="PARAMETER_DTL_CODE asc">
			<key column="PARAMETER_CODE" property-ref="parameterCode" />
			<one-to-many class="com.wo.module.parameter.model.ParameterDetail" />
		</bag>

		<property name="nameIn" column="NAME_IN" type="string" />
		<property name="nameEn" column="NAME_EN" type="string" />
		<property name="parameterCode" column="PARAMETER_CODE" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

	</class>
</hibernate-mapping>
