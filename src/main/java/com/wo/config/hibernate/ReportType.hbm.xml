<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.reportType.model">
	<class name="ReportType" table="wo_mst_report_type">
		<id name="reportTypeId" column="report_type_id" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_report_type_seq</param>
			</generator>
		</id>

		<property name="reportTypeIn" column="report_type_in" type="string" />

		<property name="reportTypeEn" column="report_type_en" type="string" />

		<property name="reportTypeDescription" column="report_type_description"
			type="string" />

		<property name="dueDay" column="due_day" type="string" />

		<property name="dueDate" column="due_date" type="string" />

		<property name="dueMonth" column="due_month" type="string" />

		<property name="dueYear" column="due_year" type="string" />

		<property name="numberOfDueDate" column="no_of_due_date"
			type="integer" />
			
		<property name="recurringType" column="recurring_type" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />


	</class>
</hibernate-mapping>
