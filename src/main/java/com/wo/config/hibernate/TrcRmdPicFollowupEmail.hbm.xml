<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcRmd.model">
	<class name="TrcRmdPicFollowupEmail" table="wo_trc_rmd_pic_followup_email">
		<id name="rmdPicFollowupEmailId" column="RMD_PIC_FOLLOWUP_EMAIL_ID"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_rmd_pic_follow_email_sq</param>
			</generator>
		</id>

		<many-to-one name="trcRmd" column="RMD_ID"
			class="com.wo.module.trcRmd.model.TrcRmd" fetch="join" />

		<property name="emailDate" column="EMAIL_DATE" type="date" />
		<property name="targetDate" column="TARGET_DATE" type="date" />
		
		<property name="emailStatus" column="EMAIL_STATUS" type="string" />
		<property name="emailSubject" column="EMAIL_SUBJECT" type="string" />
		<property name="emailContent" column="EMAIL_CONTENT" type="string" />
		<property name="resendCount" column="RESEND_COUNT" type="long" />
		
		<property name="slaType" column="sla_type" type="string" />
		<property name="sla" column="sla" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
