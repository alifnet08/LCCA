<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.qa.model">
	<class name="QA" table="wo_mst_qna">
		<id name="qnaId" column="qna_id" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_mst_qna_seq</param>
			</generator>
		</id>

		<property name="ticketNo" column="TICKET_NO" type="string" />

		<bag name="qaKeywords" inverse="true" cascade="save-update, delete-orphan"
			order-by="qna_keyword_id asc">
			<key column="qna_id" />
			<one-to-many class="com.wo.module.qa.model.QAKeyword" />
		</bag>
		
		<many-to-one name="qUser" column="Q_USER_ID"
			class="com.wo.module.user.model.User" fetch="join">
		</many-to-one>
		
		<property name="qDate" column="q_date" type="timestamp" />

		<property name="question" column="question" type="string" />

		<many-to-one name="adminUser" column="ADMIN_USER_ID"
			class="com.wo.module.user.model.User" fetch="join">
		</many-to-one>
		
		<many-to-one name="aUser" column="A_USER_ID"
			class="com.wo.module.user.model.User" fetch="join">
		</many-to-one>

		<property name="aDate" column="a_date" type="timestamp" />

		<property name="answer" column="answer" type="string" />

		<property name="qStatus" column="Q_STATUS" type="string" />

		<property name="slaType" column="SLA_TYPE" type="string" />

		<property name="categoryType" column="CATEGORY_TYPE" type="string" />
		
		<property name="threadStatus" column="THREAD_CLOSE_STATUS" type="string" />
		
		<property name="faqFlag" column="FAQ_FLAG" type="int" />
		
		<property name="readFlag" column="READ_FLAG" type="string" />
		
		<many-to-one name="fromQnaId" column="FROM_QNA_ID"
			class="com.wo.module.qa.model.QA" fetch="join">
		</many-to-one>
		
		<property name="qTitle" column="Q_TITLE" type="string" />

		<many-to-one name="aUser2" column="A_USER_ID_2"
			class="com.wo.module.user.model.User" fetch="join">
		</many-to-one>

		<property name="aDate2" column="a_date_2" type="timestamp" />

		<property name="answer2" column="answer_2" type="string" />
		
		<many-to-one name="aUser3" column="A_USER_ID_3"
			class="com.wo.module.user.model.User" fetch="join">
		</many-to-one>

		<property name="aDate3" column="a_date_3" type="timestamp" />

		<property name="answer3" column="answer_3" type="string" />
		
		<property name="publishQna" column="publish_qna" type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

		<bag name="qaAttachmentList" inverse="true" cascade="save-update, delete-orphan"
			order-by="qna_attachment_id asc">
			<key column="qna_id" />
			<one-to-many class="com.wo.module.qa.model.QAAttachment" />
		</bag>
		

	</class>
</hibernate-mapping>
