<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.trcFineApproval.model">
	<class name="TrcFinePicFollowupAttachment" table="wo_trc_fine_pic_followup_attac">
		<id name="finePicFollowupAttachmentId" column="fine_pic_followup_attachmen_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_fine_pic_fp_attac_seq</param>
			</generator>
		</id>

		<many-to-one name="trcFinePicFollowup" column="fine_pic_followup_id"
			class="com.wo.module.trcFineApproval.model.TrcFinePicFollowup"
			fetch="join" />

		<property name="attachmentFile" column="ATTACHMENT_FILE"
			type="string" />
		<property name="fileId" column="FILE_ID" type="string" />
		<property name="fileSize" column="file_size" type="long" />
		
		<property name="attachmentFrom" column="ATTACHMENT_FROM"
			type="string" />

		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
