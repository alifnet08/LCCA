<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.internalRegulationObsolete.model">
	<class name="InternalRegulationObsolete" table="wo_trc_irg_obsolete">
		<id name="internalRegulasiObsoleteId" column="irg_obsolete_id" type="long">
			<generator class="sequence">
				<param name="sequence_name">wo_trc_irg_obsolete_seq</param>
			</generator>
		</id>

		<property name="judulObsolete" column="obsolete_title" type="string" />
			
		<many-to-one name="tipeRegulasiObsolete"
			column="reg_obsolete_type"
			class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />

		<property name="nomorObsolete" column="obsolete_number" type="string" />
		<property name="infoObsolete" column="obsolete_info" type="string" />
		
		<many-to-one name="publisherDivision"
			column="publish_division_id" 
			class="com.wo.module.division.model.Division"
			fetch="join" />
		
		<property name="publisherDirectorateName" 
			column="publish_directorate_name" type="string" />
		<property name="tanggalObsolete" column="obsolete_date" type="date" />
		
		<many-to-one name="openCloseRegulationObsolete"
			column="open_close_reg_obsolete"
			class="com.wo.module.parameter.model.ParameterDetail"
			fetch="join" />

		
		<bag name="internalRegulationObsoletePicKonversis" inverse="true"
			cascade="save-update, delete-orphan" order-by="konv_pic_id asc">
			<key column="irg_obsolete_id" />
			<one-to-many not-found="ignore"
				class="com.wo.module.internalRegulationObsolete.model.InternalRegulationObsoletePic" />
		</bag>
		
		<many-to-one name="picIrg1"
			column="PIC_IRG_USER_ID_1"
			class="com.wo.module.user.model.User"
			fetch="join"/>
			
		<many-to-one name="picIrg2"
			column="PIC_IRG_USER_ID_2"
			class="com.wo.module.user.model.User"
			fetch="join"/>
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />

		

	</class>
</hibernate-mapping>
