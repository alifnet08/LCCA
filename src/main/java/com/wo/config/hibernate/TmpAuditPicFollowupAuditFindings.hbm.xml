<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.wo.module.tmpAudit.model">
	<class name="TmpAuditPicFollowupAuditFindings" table="wo_tmp_audit_pic_fp_audit_find">
		<id name="auditPicFollowupAuditFindingsId" column="audit_pic_fp_audit_find_id"
			type="long">
			<generator class="sequence">
				<param name="sequence_name">WO_TMP_AUDIT_PC_FP_ADT_FIND_SQ</param>
			</generator>
		</id>

		<many-to-one name="tmpAuditPicFollowup" column="audit_pic_followup_id"
			class="com.wo.module.tmpAudit.model.TmpAuditPicFollowup"
			fetch="join" />

		<property name="auditFindings" column="audit_findings" type="string" />
		<property name="column" column="kolom" type="int" />
		<property name="hasHeader" column="has_header" type="string" />
		
		<bag name="tmpAuditPicFollowupAuditFindingsTables" inverse="true"
			cascade="save-update, delete-orphan" order-by="adt_pc_fp_adt_find_tbl_id asc">
			<key column="audit_pic_fp_audit_find_id" />
			<one-to-many
				class="com.wo.module.tmpAudit.model.TmpAuditPicFollowupAuditFindingsTable" />
		</bag>
		
		<property name="enabledFlag" column="ENABLED_FLAG" type="string" />
		<property name="creationDate" column="CREATION_DATE" type="timestamp" />
		<property name="createdBy" column="CREATED_BY" type="string" />
		<property name="lastUpdateDate" column="LAST_UPDATE_DATE"
			type="timestamp" />
		<property name="lastUpdateBy" column="LAST_UPDATE_BY" type="string" />
		<property name="delId" column="DEL_ID" type="long" />
	</class>
</hibernate-mapping>
